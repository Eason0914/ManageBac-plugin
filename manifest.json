{
  "manifest_version": 3,
  "name": "ManageBac Planner",
  "version": "1.0.0",
  "description": "同步 ManageBac 作业，AI 估时与每日规划，计时与统计。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ManageBac Planner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "sidePanel", "notifications"],
  "host_permissions": [
    "https://*.managebac.cn/*",
    "https://api.deepseek.com/*"
  ]
}
